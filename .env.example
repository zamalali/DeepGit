# DeepGit environment configuration
# Copy this file to .env and fill in your API keys

# Required: GitHub personal access token
GITHUB_API_KEY=your_github_api_key_here

# Required: Groq API key (for DSPy LLM calls)
GROQ_API_KEY=your_groq_api_key_here

# Optional: LangSmith for observability
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false

# Optional: Override LLM provider (groq, openai, anthropic, vertex_ai)
# LLM_PROVIDER=groq
# LLM_MODEL=deepseek-r1-distill-llama-70b

# --- Vertex AI (Google Gemini) ---
# Set LLM_PROVIDER=vertex_ai and LLM_MODEL to a Gemini model to use Vertex AI.
# Auth uses Application Default Credentials — point GOOGLE_APPLICATION_CREDENTIALS
# at a service-account key file, or run `gcloud auth application-default login`.
# LLM_PROVIDER=vertex_ai
# LLM_MODEL=gemini-2.5-flash
# VERTEX_PROJECT=dbg-grcit-dev-e1
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Override retrieval settings
# MAX_RESULTS=100
# RETRIEVAL_ALPHA=0.7
# RERANK_TOP_N=50
